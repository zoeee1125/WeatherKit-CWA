[Argument]
{{{arguments}}}

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ requires-body=1, script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/response.bundle.js, tag=🌤 WeatherKit.api.v1.availability.response, argument={{{scriptParams}}}
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/request.bundle.js, tag=🌤 WeatherKit.api.v1.airQualityScale.request, argument={{{scriptParams}}}
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$) script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/request.bundle.js, tag=🌤 WeatherKit.api.v1.weatherAlerts.api.request, argument={{{scriptParams}}}
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/request.bundle.js, tag=🌤 WeatherKit.api.v2.weather.request, argument={{{scriptParams}}}
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ requires-body=1, binary-body-mode=1, script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/response.bundle.js, tag=🌤 WeatherKit.api.v2.weather.response, argument={{{scriptParams}}}
cron "*/30 * * * *" script-path=https://github.com/zoeee1125/WeatherKit-CWA/releases/latest/download/notify.bundle.js, tag=🌤 WeatherKit.rainAlert.cron, timeout=30, enable=true, argument={{{scriptParams}}}

[MITM]
hostname = weatherkit.apple.com
